# Copy this file to .env and edit as needed.
# All values below are the defaults used when running docker-compose up.

# Neo4j credentials — must match what you set in the neo4j container
NEO4J_AUTH=neo4j/playground123
NEO4J_USER=neo4j
NEO4J_PASSWORD=playground123

# Override the ChromaDB host/port if you're running it outside Docker
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Default Gemini models (can be overridden per-request from the UI)
# DEFAULT_GEN_MODEL=gemini-2.5-flash
# DEFAULT_EMBED_MODEL=gemini-embedding-001

# SQLite path for saved API keys and collection metadata
# ARENA_DB_PATH=arena.db

# MCP: allow stdio servers (they execute commands inside the api container). Default: false
# ALLOW_STDIO_MCP=false
# Host headers the built-in MCP server at /mcp/ accepts (comma-separated, ports may be *)
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
