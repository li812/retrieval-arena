# Copy this file to .env and edit as needed.
# All values below are the defaults used by `docker compose up`.

# Neo4j credentials — must match what you set in the neo4j container
NEO4J_AUTH=neo4j/playground123
NEO4J_USER=neo4j
NEO4J_PASSWORD=playground123

# Override the ChromaDB host/port if you're running it outside Docker
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Default Gemini models (can be overridden per-request from the UI)
# DEFAULT_GEN_MODEL=gemini-2.5-flash
# DEFAULT_EMBED_MODEL=gemini-embedding-001

# SQLite database. In Docker this is /app/arena_data/arena.db (inside the arena_data volume).
# Outside Docker a relative path is relative to the directory you start the API from (backend/).
# ARENA_DB_PATH=arena.db

# Run database migrations on startup. A database created before migrations existed is
# backed up first to <db>.pre-alembic-<UTC timestamp>.bak. Default: true
# AUTO_MIGRATE=true

# Built React app served at /app/. The Docker image sets /app/frontend_dist.
# Default: frontend/dist in the repository.
# ARENA_SPA_DIR=/app/frontend_dist

# Logging: LOG_FORMAT is json (one JSON object per line) or console. LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Seconds each /readyz dependency check (SQLite, Chroma, Neo4j) may take before it counts as failed
# READYZ_TIMEOUT_S=2

# MCP: allow stdio servers (they execute commands inside the api container). Default: false
# ALLOW_STDIO_MCP=false
# Host headers the built-in MCP server at /mcp/ accepts (comma-separated, ports may be *)
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
